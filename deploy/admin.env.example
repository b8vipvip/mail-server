# Copy to /etc/mail-server/admin.env. Never commit the real file.
ADMIN_SECRET_KEY=replace-with-a-long-random-secret
# Generate with:
# /opt/mail-server/.venv/bin/python -c 'from werkzeug.security import generate_password_hash; import getpass; print(generate_password_hash(getpass.getpass()))'
ADMIN_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
ADMIN_URL_PREFIX=/admin
DMS_ALLOWED_DOMAINS=cn2.io,mv3.cn
AUDIT_LOG=/var/log/mail-server/audit.log
