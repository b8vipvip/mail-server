[Unit]
Description=DMS Mail Admin privileged helper
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
Environment=MAILADMIN_GROUP=mailadmin
ExecStart=/usr/local/sbin/dms-admin-helper-server
Restart=on-failure
RestartSec=3
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/dms-admin /var/backups/dms-admin /var/log/mail-server
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
