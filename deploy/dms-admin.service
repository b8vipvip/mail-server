[Unit]
Description=DMS Mail Admin
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/mail-server/admin
EnvironmentFile=/etc/mail-server/admin.env
ExecStart=/opt/mail-server/.venv/bin/gunicorn --workers 1 --threads 2 --bind 127.0.0.1:8090 --access-logfile - --error-logfile - app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
